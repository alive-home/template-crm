# Public origins — both apps consume both values.
# API: used by api for CORS and for issuing absolute URLs.
# WEB: used by web (via VITE_*) for the tRPC and auth client.
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Vite-exposed copies for the browser bundle.
#
# VITE_API_BASE_URL: leave UNSET (or empty) when web's nginx proxies
# /trpc to the api container — the tRPC client falls back to "/trpc"
# (same-origin), which is what production / the Alive deploy default
# expects. Set to an absolute URL only for split-port local dev.
VITE_API_BASE_URL=http://localhost:3001
VITE_WEB_BASE_URL=http://localhost:3000

# The CRM database. Both are required and neither has a default in code: a default is what lets a
# misconfigured environment boot cleanly against the wrong database and look like it lost its data.
# Left empty, the api still boots and every /api/crm/* request answers with a sentence naming the
# missing variable. The URL is ordinary config, e.g. libsql://<your-database>.turso.io (the
# turso:// form the vendor prints is accepted too). The token is a rotating secret: set it in
# Alive's env settings or on your platform, never in a committed file.
#
# A brand new database has no tables. Run `bun apps/api/scripts/migrate.ts` once against it. That is
# also the command that upgrades an existing one; it only ever adds.
TURSO_DATABASE_URL_CRM=
TURSO_API_KEY_CRM=

# The one password in front of the CRM. Empty outside production means no gate; empty in production
# means the api serves nothing and names this variable. There is no user table and no default.
CRM_PASSWORD=

# Only for the scripts under apps/api/scripts, never read by the app.
#
# The Alive services host (discovery, stealth fetch, AI extract, KvK). ALIVE_SECRET_KEY is generated
# into .env.development by the platform and is deliberately the one secret that stays in a file: it is
# what buys access to the services, so it cannot come from them.
ALIVE_SERVICES_URL=https://services.example.com

# Which addresses are ours, for apps/api/scripts/mail-sync.ts: it decides whether a message is
# inbound. Comma-separated addresses or @domain suffixes. No default — an empty pattern would silently
# mark every message as incoming and pick the counterpart from our own side.
OUR_ADDRESSES=me@example.com,@mycompany.com
